{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Disclosure WordPress development API",
    "version": "0.1.0-alpha.3",
    "description": "Private assessment of proposed text; publish through WordPress core endpoints. Body limit 1 MiB. Identical retries are safe; conflicting facts return 409. Responses carry Cache-Control: private, no-store."
  },
  "servers": [
    {
      "url": "/wp-json"
    }
  ],
  "security": [
    {
      "applicationPassword": []
    },
    {
      "wpNonce": []
    }
  ],
  "paths": {
    "/ai-disclosure/v1/posts/{id}/assessment": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "operationId": "inspectDisclosureVersion",
        "responses": {
          "200": {
            "description": "Private assessment result, not legal certification.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "revision",
                    "recorded",
                    "supported_text",
                    "policy",
                    "assessment"
                  ],
                  "properties": {
                    "revision": {
                      "type": "string"
                    },
                    "recorded": {
                      "type": "boolean"
                    },
                    "supported_text": {
                      "type": "boolean"
                    },
                    "policy": {
                      "type": "string"
                    },
                    "assessment": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/PrivateRecord"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "recordDisclosureAssessment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Assessment"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Private assessment result, not legal certification.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "revision",
                    "decision",
                    "policy",
                    "implementation_verified",
                    "record_id"
                  ],
                  "properties": {
                    "revision": {
                      "type": "string"
                    },
                    "decision": {
                      "type": "string",
                      "enum": [
                        "outside_declared_scope",
                        "no_publisher_label",
                        "exception_declared",
                        "disclose"
                      ]
                    },
                    "policy": {
                      "type": "string"
                    },
                    "implementation_verified": {
                      "type": "boolean",
                      "const": false
                    },
                    "record_id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Record established facts for a content version. Send expected_revision to reject stale inspected versions before any write. It does not publish content; existing amendment and idempotent-retry rules still apply."
      }
    },
    "/ai-disclosure/v1/posts/{id}/assessments/{record_id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        },
        {
          "name": "record_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      ],
      "get": {
        "operationId": "readArchivedAssessment",
        "responses": {
          "200": {
            "description": "One private retained snapshot. Presence alone does not prove replacement committed; inspect the active record and its supersedes chain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivateRecord"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/ai-disclosure/v1/posts/{id}/inspection": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "post": {
        "operationId": "inspectProposedEditorText",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "excerpt": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inspect proposed editor text without saving content or assessment facts. May return private facts for an already recorded version.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "revision",
                    "supported_text",
                    "policy",
                    "assessment"
                  ],
                  "properties": {
                    "revision": {
                      "type": "string"
                    },
                    "supported_text": {
                      "type": "boolean"
                    },
                    "policy": {
                      "type": "string"
                    },
                    "assessment": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/PrivateRecord"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/ai-disclosure/v1/posts/{id}/withdrawal": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "post": {
        "summary": "Withdraw the saved draft assessment while retaining its audit history.",
        "description": "Requires draft status and exact saved revision. Repeating the same replaced ID and reason returns the same withdrawn record. Stale requests return 409. Explicit assessment amendment is required to restore publication permission.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "revision",
                  "replaces",
                  "reason"
                ],
                "properties": {
                  "revision": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "replaces": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Nonblank; at most 1000 UTF-8 bytes."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Private withdrawn record. Historical facts are retained, not approved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivateRecord"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/ai-disclosure/v1/inventory": {
      "get": {
        "summary": "Inventory authorized post/page source records without changing them.",
        "description": "Scans every post/page status, including draft, auto-draft and trash. ID cursors bound database work. Keep through_id from the first response on subsequent requests. An empty items array may still have next_after; stop only when it is null. This is not a consistent snapshot or proof of complete rendered-site coverage. Evidence bodies are omitted. Requires publish_posts or publish_pages and filters each item by edit and publication capabilities.",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "through_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Upper ID returned by the first page. New posts beyond it require a later scan."
          }
        ],
        "responses": {
          "200": {
            "description": "Private bounded source inventory. All responses use private, no-store caching.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "through_id",
                    "next_after",
                    "policy",
                    "coverage"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "type",
                          "status",
                          "title_excerpt",
                          "revision",
                          "supported_text",
                          "decision"
                        ],
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "post",
                              "page"
                            ]
                          },
                          "status": {
                            "type": "string"
                          },
                          "title_excerpt": {
                            "type": "string",
                            "description": "Plain title excerpt, at most 160 characters plus ellipsis."
                          },
                          "revision": {
                            "type": "string",
                            "pattern": "^sha256:[a-f0-9]{64}$"
                          },
                          "supported_text": {
                            "type": "boolean"
                          },
                          "decision": {
                            "type": "string",
                            "enum": [
                              "unassessed",
                              "withdrawn",
                              "disclose",
                              "exception_declared",
                              "no_publisher_label",
                              "outside_declared_scope"
                            ]
                          }
                        }
                      }
                    },
                    "through_id": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "next_after": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "policy": {
                      "type": "string"
                    },
                    "coverage": {
                      "type": "string",
                      "const": "post-page-source-only"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "applicationPassword": {
        "type": "http",
        "scheme": "basic",
        "description": "WordPress username and application password over HTTPS."
      },
      "wpNonce": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Requires an existing authenticated WordPress cookie session as well."
      }
    },
    "responses": {
      "Error": {
        "description": "WordPress error object; code is machine-readable.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "code",
                "message",
                "data"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Assessment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "facts"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "publisher",
              "provider",
              "both",
              "unknown"
            ],
            "description": "Only an established publisher role passes. Omission remains unresolved."
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "facts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin"
            ],
            "properties": {
              "origin": {
                "type": "string",
                "enum": [
                  "human",
                  "ai_generated",
                  "ai_modified",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "applicable": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "public_interest": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "review": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "revision",
                  "substantive_human_review",
                  "responsible_entity"
                ],
                "properties": {
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "substantive_human_review": {
                    "type": "boolean"
                  },
                  "responsible_entity": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "replaces": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Current record ID; required when amending facts."
          },
          "amendment_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Nonblank reason, limited to 1000 UTF-8 bytes."
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$",
            "description": "Optional exact revision of the final title/content/excerpt after proposed fields are applied. A mismatch returns 409 before recording or amending. Use the inspection revision for evidence-backed migration and proposed edits. Omission preserves the existing API behavior.",
            "minLength": 71,
            "maxLength": 71
          }
        },
        "dependentRequired": {
          "replaces": [
            "amendment_reason"
          ],
          "amendment_reason": [
            "replaces"
          ]
        }
      },
      "PrivateRecord": {
        "type": "object",
        "required": [
          "record_id",
          "policy",
          "decision",
          "facts",
          "actor",
          "recorded_at",
          "supersedes",
          "amendment_reason"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "policy": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "description": "withdrawn invalidates publication approval; retained facts are historical."
          },
          "facts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "revision",
              "origin"
            ],
            "properties": {
              "origin": {
                "type": "string",
                "enum": [
                  "human",
                  "ai_generated",
                  "ai_modified",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "applicable": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "public_interest": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "review": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "revision",
                  "substantive_human_review",
                  "responsible_entity"
                ],
                "properties": {
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "substantive_human_review": {
                    "type": "boolean"
                  },
                  "responsible_entity": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "text"
              },
              "revision": {
                "type": "string"
              }
            }
          },
          "actor": {
            "type": "integer"
          },
          "recorded_at": {
            "type": "string"
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          },
          "amendment_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
